# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# AI tool configs
.serena/

# JEV code-review sidecars (per-diff hashes; same entries the installer writes)
.spec/reviews/
.spec/specs/*/review/jev-review-*
# This repository also keeps spec-phase JEV sidecars local (installed projects still track them)
.spec/specs/*/review/jev-*

# Generated SDD agent installs
# Created by: npx sdd-mcp-server@latest install --all
.claude/agents/
.claude/contexts/
.claude/hooks/
.claude/rules/
.claude/skills/
.agents/
.codex/

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm
.npm-cache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Temporary directories
tmp/
temp/

# SDD migration backups
.spec/steering.backup/
.spec/steering.backup-*/

# Claude Code local settings
.claude/settings.local.json

# BEGIN sdd-mcp generated agent files
.claude/
.omp/
.sdd-mcp/
# END sdd-mcp generated agent files
