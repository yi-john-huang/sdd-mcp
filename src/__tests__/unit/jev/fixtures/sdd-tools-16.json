  {
    "name": "sdd-validate-gap",
    "description": "Analyze the implementation gap",
    "inputSchema": {
      "type": "object",
      "properties": {
        "featureName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "Feature name under .spec/specs"
        }
      },
      "required": [
        "featureName"
      ],
