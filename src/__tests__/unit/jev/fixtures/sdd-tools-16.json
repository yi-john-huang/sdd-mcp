          "type": "string"
        },
        "inclusionMode": {
          "type": "string",
          "enum": [
            "always",
            "conditional",
            "manual"
          ]
        },
        "filePattern": {
          "type": "string"
        }
      },
      "required": [
        "fileName",
        "topic",
        "inclusionMode"
      ],
      "additionalProperties": false
    }
  },
