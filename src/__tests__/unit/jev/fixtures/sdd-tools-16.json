[
  {
    "name": "sdd-init",
    "description": "Initialize a governed SDD feature",
    "inputSchema": {
      "type": "object",
      "properties": {
        "featureName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "Feature name under .spec/specs"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "ja",
            "zh-TW"
          ]
        },
        "clarificationAnswers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "featureName",
        "description"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "sdd-requirements",
    "description": "Submit requirements artifact",
    "inputSchema": {
      "type": "object",
      "properties": {
        "featureName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "Feature name under .spec/specs"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "expectedArtifactSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      },
      "required": [
        "featureName",
        "content",
        "expectedRevision",
        "expectedArtifactSha256"
      ],
      "additionalProperties": false
    }
  },
