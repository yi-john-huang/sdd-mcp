          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "description": "Feature name under .spec/specs"
        },
        "templateType": {
          "type": "string",
          "enum": [
            "requirements",
            "design",
            "tasks"
          ]
        },
        "customTemplate": {
          "type": "string"
        }
      },
      "required": [
        "featureName",
        "templateType"
      ],
      "additionalProperties": false
    }
  },
